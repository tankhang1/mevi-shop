# Mock backend (src/mocks). Set false to call the real API via VITE_API_URL.
VITE_USE_MOCK=true
VITE_API_URL=
# Storefront products/categories: real /api/public/shop unless true
VITE_USE_MOCK_SHOP=false

# Real backend (apiClient: auth + /api/*)
VITE_API_BASE_URL=https://api.example.com
VITE_AUTH_PROVIDER=farm
VITE_AUTH_CALLBACK_PATH=/auth/callback
VITE_AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

# Admin portal (separate app)
VITE_ADMIN_URL=https://mevi-shop-admin.vercel.app/
